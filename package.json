{
  "name": "jsoncc-lab",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run dev\" \"npm run workers:dev\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "workers:dev": "wrangler dev --config workers/wrangler.toml",
    "workers:deploy": "wrangler deploy --config workers/wrangler.toml",
    "workers:kv-bind": "tsx scripts/worker-kv-bind.ts",
    "history:generate": "tsx scripts/generate-history-daily.ts",
    "history:send-mail": "tsx scripts/send-history-mail.ts",
    "history:daily": "npm run history:generate && npm run history:send-mail",
    "hotnews:generate": "tsx scripts/generate-hotnews-daily.ts",
    "hotnews:daily": "npm run hotnews:generate",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "dependencies": {
    "@iconify-icons/mdi": "^1.2.48",
    "@iconify-icons/radix-icons": "^1.2.9",
    "@iconify/vue": "^5.0.0",
    "crypto-js": "^4.2.0",
    "docx": "^8.5.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lunar-javascript": "^1.7.7",
    "lunar-typescript": "^1.8.6",
    "marked": "^17.0.5",
    "marked-highlight": "^2.2.4",
    "nodemailer": "^7.0.9",
    "opencc-js": "^1.0.5",
    "pdfjs-dist": "^4.9.155",
    "solarlunar": "^3.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.3",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "~5.7.2",
    "vite": "^5.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10",
    "wrangler": "^3.114.1"
  }
}
